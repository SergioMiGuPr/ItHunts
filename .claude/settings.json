{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "mcp__blender__execute_blender_code",
      "mcp__blender__generate_3d",
      "Bash(git commit *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Edit(Library/**)",
      "Edit(Temp/**)"
    ]
  }
}
