  - {fileID: 21300000, guid: ca6c58605d63d24418638ef1a216b8a5, type: 3}
  etoile: {fileID: 21300000, guid: ad50e56f2d6408f41bfb74921c66967c, type: 3}
  etoileVide: {fileID: 21300000, guid: 8dfdad3c0690af543a49d33ea59dca7e, type: 3}
  couleursPersonnage:
  - {r: 0.8, g: 0.78, b: 0.74, a: 1}
  - {r: 0.867, g: 0.216, b: 0.247, a: 1}
  - {r: 0.902, g: 0.667, b: 0.18, a: 1}
  - {r: 0.333, g: 0.784, b: 0.318, a: 1}
  - {r: 0.373, g: 0.725, b: 0.929, a: 1}
  fiches:
  - id: G1
    nom: Riposte
    effet: "Une parade r\xE9ussie renvoie une onde qui blesse les ennemis autour"
    rangs:
    - 15 PV, 3 m
    - 22 PV, 3.5 m
    - 30 PV, 4 m, repousse
    - 40 PV, 4.5 m
    - "55 PV, 5 m, <b>l'onde \xE9tourdit 1.5 s</b>"
    synergies: "D\xE9tonateur (G20), Briseur d'os (G21)"
  - id: G2
    nom: Garde large
    effet: "Fen\xEAtre de parade plus longue"
    rangs:
    - +40 ms
    - +60 ms
    - "+80 ms, la tol\xE9rance tardive double"
    - +100 ms
    - "+120 ms, <b>pare aussi les d\xE9bris et les projectiles (boss compris)</b>"
    synergies: Rythme de fer (G4)
  - id: G3
    nom: Second souffle
    effet: "Une parade r\xE9ussie rend des PV"
    rangs:
    - 6 PV
    - 9 PV
    - 12 PV + une charge de mouvement
    - 16 PV
    - 22 PV, <b>+ une charge de traction</b>
    synergies: Charge en plus (G23), Traction rapide (G10)
  - id: G4
    nom: Rythme de fer
    effet: "Chaque parade r\xE9ussie d'affil\xE9e (6 s) augmente vos d\xE9g\xE2ts"
    rangs:
    - +10 % par parade, max 3
    - +15 %, max 3
    - +20 %, max 4
    - +25 %, max 4
    - "+30 %, max 5, <b>\xE0 3 parades : le temps ralentit 1 s autour de vous</b>
      (pas en coop en ligne : effet local)"
    synergies: "Pr\xE9dateur (G22)"
  - id: G5
    nom: Grande orbe
    effet: "Rayon de collecte des \xE2mes"
    rangs:
    - +25 % (10 m)
    - +40 %
    - +60 %
    - +85 %
    - "+120 % (17.6 m), <b>collecte \xE0 travers les murs</b>"
    synergies: Aspiration (G6), Flair (R-P2)
  - id: G6
    nom: Aspiration
    effet: "Les \xE2mes viennent plus vite, les coffres offrent leur choix plus longtemps"
    rangs:
    - +50 %
    - +80 %
    - "+110 %, les \xE2mes au sol durent 45 s"
    - +150 %
    - "+200 %, <b>chaque \xE2me ramass\xE9e soigne 1 PV</b>"
    synergies: "Grande orbe (G5), \xC2mes gourmandes (G7)"
  - id: G7
    nom: "\xC2mes gourmandes"
    effet: "Plus d'\xE2mes par ennemi tu\xE9"
    rangs:
    - +10 %
    - +18 %
    - "+25 %, +1 \xE2me par kill \xE0 plus de 14 m/s"
    - +35 %
    - "+50 %, <b>kill \xE0 plus de 14 m/s : \xE2mes doubl\xE9es</b>"
    synergies: Vif-argent (G26), Semelles de vent (G24)
  - id: G8
    nom: Marchandage
    effet: "Prix du marchand r\xE9duits"
    rangs:
    - "\u22128 %"
    - "\u221214 %"
    - "\u221220 %, la hausse par achat est divis\xE9e par 2"
    - "\u221226 %"
    - "\u221233 %, <b>la premi\xE8re mont\xE9e de rang de chaque acte est gratuite</b>"
    synergies: "\u0152il du collectionneur (G30)"
  - id: G9
    nom: Orbe vorace
    effet: "Chaque \xE2me ramass\xE9e r\xE9duit vos recharges (traction, artefact,
      dash)"
    rangs:
    - "0.05 s par \xE2me"
    - 0.08 s
    - "0.11 s, aussi la recharge de la r\xE9pulsion"
    - 0.15 s
    - 0.2 s, <b>un kill rend une charge de traction</b>
    synergies: Traction rapide (G10), Main leste (C5)
  - id: G10
    nom: Traction rapide
    effet: Une charge de traction revient plus vite
    rangs:
    - "\u22121 s (5 s)"
    - "\u22121.6 s"
    - "\u22122.2 s"
    - "\u22122.8 s"
    - "\u22123.4 s, <b>l'arriv\xE9e d'une traction rend la charge si vous atterrissez
      \xE0 plus de 12 m/s</b>"
    synergies: Second souffle (G3), Orbe vorace (G9)
  - id: G11
    nom: Harpon
    effet: "La traction vise aussi les <b>ennemis</b> : vous \xEAtes tir\xE9 vers
      eux"
    rangs:
    - goules
    - goules et volants
    - "l'arriv\xE9e frappe 20 PV"
    - "35 PV et \xE9tourdit 1 s"
    - "50 PV, <b>l'arriv\xE9e explose (3 m)</b>"
    synergies: "Briseur d'os (G21), D\xE9tonateur (G20), Fente (K3)"
  - id: G12
    nom: "\xC9lan de traction"
    effet: "La traction acc\xE9l\xE8re plus vite et garde plus d'\xE9lan \xE0 l'arriv\xE9e
      (plafond 18 inchang\xE9)"
    rangs:
    - "acc\xE9l\xE9ration +25 %"
    - +50 %
    - "+75 %, l'\xE9lan de sortie est gard\xE9 1 s de plus"
    - +100 %
    - "+125 %, <b>4 s de tractions sans charge apr\xE8s une parade r\xE9ussie</b>"
    synergies: Garde large (G2), Vif-argent (G26)
  - id: G13
    nom: Sillage
    effet: "Pendant une traction, vous laissez une tra\xEEn\xE9e qui blesse et ralentit
      les ennemis travers\xE9s"
    rangs:
    - "8 PV, \u221220 % 2 s"
    - 12 PV
    - "16 PV, \u221235 %"
    - 22 PV
    - "30 PV, <b>la tra\xEEn\xE9e enflamme</b>"
    synergies: Allumette (G28), Fourrure de braise (R-P1)
  - id: G14
    nom: Onde blessante
    effet: "L'onde de r\xE9pulsion blesse les ennemis touch\xE9s"
    rangs:
    - 10 PV
    - 15 PV
    - 20 PV, ralentit 1.5 s
    - 28 PV
    - "38 PV, <b>double onde (une seconde 0.3 s apr\xE8s)</b>"
    synergies: Rebond (G16), Onde de choc (G15)
  - id: G15
    nom: Onde de choc
    effet: "R\xE9pulsion plus large et plus longue"
    rangs:
    - "+10\xB0, +2 m"
    - "+15\xB0, +3 m"
    - "+20\xB0, +4 m, les objets repouss\xE9s vont 20 % plus vite"
    - "+25\xB0, +5 m"
    - "+30\xB0, +6 m, <b>renvoie les d\xE9bris et projectiles du boss</b>"
    synergies: Projectiles lourds (G18)
  - id: G16
    nom: Rebond
    effet: "Un ennemi repouss\xE9 contre un mur ou un autre ennemi prend des d\xE9g\xE2ts
      d'impact"
    rangs:
    - "\xD71.5"
    - "\xD71.8"
    - "\xD72.1, \xE9tourdit 1 s"
    - "\xD72.5"
    - "\xD73, <b>l'ennemi projet\xE9 qui meurt explose (3.5 m)</b>"
    synergies: "D\xE9tonateur (G20), Briseur d'os (G21)"
  - id: G17
    nom: "Charge de r\xE9pulsion"
    effet: "La r\xE9pulsion a une charge en plus ; sa recharge est plus courte"
    rangs:
    - +1 charge
    - "recharge \u22121 s"
    - "\u22121.5 s"
    - +2 charges
    - "<b>la r\xE9pulsion sur le sol vous propulse en hauteur (saut de 4 m) sans
      d\xE9penser de charge de mouvement</b>"
    synergies: Pas de chat (G25), Chute amortie (G27)
  - id: G18
    nom: Projectiles lourds
    effet: "Objets lanc\xE9s ou repouss\xE9s : plus de d\xE9g\xE2ts (zone comprise)"
    rangs:
    - +25 %
    - +40 %
    - +60 %, les objets ne se brisent plus au premier impact
    - +85 %
    - "+120 %, <b>un objet lanc\xE9 revient vers l'orbe apr\xE8s l'impact</b>"
    synergies: "Onde de choc (G15), Langue de cam\xE9l\xE9on (C8)"
  - id: G19
    nom: "C\u0153ur solide"
    effet: PV max
    rangs:
    - +25 (et autant tout de suite)
    - +40
    - "+55, r\xE9g\xE9n\xE9ration 1 PV / 4 s hors combat"
    - +75
    - "+100, <b>une fois par run, vous revenez \xE0 50 % de PV au lieu de mourir</b>
      (pas face \xE0 la prise du traqueur)"
    synergies: "Second souffle (G3), Peau \xE9paisse (K-P1)"
  - id: G20
    nom: "D\xE9tonateur"
    effet: "Un ennemi <b>\xE9tourdi ou paralys\xE9</b> qui meurt explose"
    rangs:
    - 20 PV, 3 m
    - 28 PV, 3.5 m
    - "36 PV, 4 m, l'explosion \xE9tourdit 0.8 s"
    - 46 PV, 4.5 m
    - "60 PV, 5 m, <b>cha\xEEne : les morts par explosion explosent (3 maillons)</b>"
    synergies: Riposte (G1), Rebond (G16), Balles paralysantes (C1)
  - id: G21
    nom: Briseur d'os
    effet: "D\xE9g\xE2ts contre les ennemis \xE9tourdis ou paralys\xE9s"
    rangs:
    - "\xD71.25"
    - "\xD71.45"
    - "\xD71.65, l'\xE9tourdissement dure 0.5 s de plus"
    - "\xD71.9"
    - "\xD72.2, <b>un \xE9tourdi sous 30 % de PV meurt du coup suivant</b>"
    synergies: "D\xE9tonateur (G20), Harpon (G11), Brise-garde (K7)"
  - id: G22
    nom: "Pr\xE9dateur"
    effet: "Chaque kill : +d\xE9g\xE2ts pendant 5 s (piles)"
    rangs:
    - +6 %, max 5
    - +8 %, max 5
    - +10 %, max 6, + vitesse de course +0.5 m/s
    - +12 %, max 6
    - "+15 %, max 8, <b>\xE0 5 piles : vos attaques \xE9tourdissent</b>"
    synergies: "Rythme de fer (G4), \xC9lan du b\xFBcheron (K8)"
  - id: G23
    nom: Charge en plus
    effet: Charges de mouvement (dash, saut en l'air)
    rangs:
    - +1
    - "recharge au sol \u22120.5 s"
    - +2
    - "recharge en l'air \u22121 s"
    - "+3, <b>2 s de dashs gratuits apr\xE8s un kill</b>"
